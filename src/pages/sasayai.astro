---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'

// 获取 sasayai 集合
const posts = await getCollection('sasayai')

// 按时间倒序排序
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// 预先渲染所有内容
const renderedPosts = await Promise.all(
  sortedPosts.map(async(post) => {
    const { Content } = await render(post)
    return { post, Content }
  })
)

// 瀑布流列数
const col1: typeof renderedPosts = []
const col2: typeof renderedPosts = []
renderedPosts.forEach((item, index) => {
  if (index % 2 === 0) col1.push(item)
  else col2.push(item)
})

const title = 'Sasayai | 絮语';
---

<BaseLayout pageTitle={title}>
  <div class="sasayai-container">
    <header class="sasayai-header">
      <h1 class="glow-text">Sasayai</h1>
      <p class="subtitle">低语，或者那些无可归处的碎碎念。</p>
    </header>

    <!-- 发布区域 -->
    <div class="publish-panel card">
      <div class="token-banner" id="token-status">
        <span>🔒 未设置 GitHub Token</span>
        <button id="show-settings-btn" class="text-btn">去设置</button>
      </div>

      <div class="settings-area hidden" id="settings-area">
        <input type="password" id="token-input" placeholder="输入你的 GitHub Fine-grained Token" class="minimal-input" />
        <button id="save-token-btn" class="action-btn">保存</button>
      </div>

      <div class="input-area hidden" id="input-area">
        <textarea id="thought-input" placeholder="在这块发光的板板上，写下你的低语..." class="minimal-input"></textarea>
        <div class="input-footer">
          <span id="char-count">0/500</span>
          <button id="publish-btn" class="action-btn">发送</button>
        </div>
      </div>
    </div>

    <!-- 瀑布流列表区域 -->
    <div class="masonry-grid">
      <!-- 第一列 -->
      <div class="masonry-col">
        {col1.map(({ post, Content }) => (
          <div class="thought-card card">
            <div class="thought-header">
              <span class="thought-date">
                {post.data.date.toLocaleString('zh-CN', {
                  timeZone: 'Asia/Shanghai',
                  month: '2-digit',
                  day: '2-digit',
                  hour: '2-digit',
                  minute: '2-digit'
                })}
              </span>
              <span class="thought-id">#{post.data.id || 'N/A'}</span>
            </div>
            <div class="thought-content markdown-body">
              <Content />
            </div>
          </div>
        ))}
      </div>

      <!-- 第二列 -->
      <div class="masonry-col">
        {col2.map(({ post, Content }) => (
          <div class="thought-card card">
            <div class="thought-header">
              <span class="thought-date">
                {post.data.date.toLocaleString('zh-CN', {
                  timeZone: 'Asia/Shanghai',
                  month: '2-digit',
                  day: '2-digit',
                  hour: '2-digit',
                  minute: '2-digit'
                })}
              </span>
              <span class="thought-id">#{post.data.id || 'N/A'}</span>
            </div>
            <div class="thought-content markdown-body">
              <Content />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .sasayai-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .sasayai-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .glow-text {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text, #333);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted, #777);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  /* 极简卡片基础样式 */
  .card {
    background: var(--color-bg-card, rgba(255, 255, 255, 0.9));
    border: 1px solid var(--color-border, #eee);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  :global(.dark) .card {
    background: var(--color-bg-card, rgba(30, 30, 35, 0.9));
    border: 1px solid var(--color-border, #333);
  }

  /* 发布面板 */
  .publish-panel {
    margin-bottom: 3rem;
  }

  .token-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
  }

  .text-btn {
    background: none;
    border: none;
    color: var(--color-primary, #a18cd1);
    cursor: pointer;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
  }

  .text-btn:hover {
    text-decoration: underline;
  }

  .settings-area {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .input-area {
    margin-top: 1rem;
  }

  .minimal-input {
    width: 100%;
    padding: 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--color-border, #ddd);
    background: var(--color-bg, #fff);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  :global(.dark) .minimal-input {
    background: #1a1a1a;
    border-color: #444;
    color: #fff;
  }

  .minimal-input:focus {
    outline: none;
    border-color: var(--color-primary, #a18cd1);
  }

  textarea.minimal-input {
    min-height: 100px;
    resize: vertical;
  }

  .input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.8rem;
    font-size: 0.8rem;
    color: var(--color-text-muted, #777);
  }

  .action-btn {
    background: var(--color-primary, #2c3e50);
    border: none;
    color: white;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .action-btn:hover {
    opacity: 0.9;
  }

  /* 瀑布流网格 */
  .masonry-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .masonry-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .thought-card:hover {
    border-color: var(--color-primary, #a18cd1);
  }

  .thought-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-text-muted, #777);
    margin-bottom: 0.6rem;
  }

  .thought-id {
    font-family: var(--font-mono, monospace);
    opacity: 0.5;
  }

  .thought-content {
    line-height: 1.6;
    color: var(--color-text, #333);
    font-size: 0.95rem;
  }

  :global(.dark) .thought-content {
    color: #ccc;
  }

  /* 确保 Markdown 内容样式正常 */
  .thought-content :global(p) {
    margin: 0.4rem 0;
  }

  .thought-content :global(ul) {
    padding-left: 1.2rem;
    margin: 0.4rem 0;
  }

  /* 响应式 */
  @media (max-width: 600px) {
    .masonry-grid {
      grid-template-columns: 1fr;
    }
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
import { decodeGitHubFile, encodeGitHubFile } from '@/scripts/sasayai'

let cleanupPublishPanel: (() => void) | undefined

function initPublishPanel() {
  cleanupPublishPanel?.()
  const tokenInput = document.querySelector<HTMLInputElement>('#token-input')
  const saveTokenBtn = document.querySelector<HTMLButtonElement>('#save-token-btn')
  const tokenStatus = document.getElementById('token-status')
  const showSettingsBtn = document.querySelector<HTMLButtonElement>('#show-settings-btn')
  const settingsArea = document.getElementById('settings-area')
  const inputArea = document.getElementById('input-area')
  const thoughtInput = document.querySelector<HTMLTextAreaElement>('#thought-input')
  const publishBtn = document.querySelector<HTMLButtonElement>('#publish-btn')
  const charCount = document.getElementById('char-count')
  if (!tokenInput || !saveTokenBtn || !showSettingsBtn || !tokenStatus || !settingsArea || !inputArea || !thoughtInput || !publishBtn) return

  const controller = new AbortController()
  cleanupPublishPanel = () => controller.abort()
  let token = ''
  let sending = false
  try { token = localStorage.getItem('github_token') || '' } catch { /* Session-only tokens still work. */ }

  const statusText = document.createElement('span')
  const settingsButton = showSettingsBtn
  settingsButton.id = 'show-settings-btn'
  settingsButton.type = 'button'
  settingsButton.className = 'text-btn'
  const clearButton = showSettingsBtn.cloneNode(true) as HTMLButtonElement
  clearButton.id = 'clear-token-btn'
  clearButton.type = 'button'
  clearButton.className = 'text-btn'
  clearButton.textContent = '清除'
  tokenStatus.replaceChildren(statusText, settingsButton, clearButton)

  function updateTokenStatus(persistent = true) {
    statusText.textContent = token
      ? persistent ? '🔓 Token 已保存在此浏览器' : '🔓 Token 仅用于本次页面访问'
      : '🔒 未设置 GitHub Token'
    settingsButton.textContent = token ? '更换' : '去设置'
    clearButton.hidden = !token
    inputArea!.classList.toggle('hidden', !token)
    settingsArea!.classList.add('hidden')
  }
  updateTokenStatus()
  tokenInput.setAttribute('aria-label', 'GitHub Fine-grained Token')
  thoughtInput.setAttribute('aria-label', '絮语内容')
  thoughtInput.maxLength = 500

  settingsButton.addEventListener('click', () => {
    settingsArea.classList.toggle('hidden')
    if (!settingsArea.classList.contains('hidden')) tokenInput.focus()
  }, { signal: controller.signal })
  saveTokenBtn.addEventListener('click', () => {
    const value = tokenInput.value.trim()
    if (!value) return
    token = value
    let persistent = true
    try { localStorage.setItem('github_token', token) } catch { persistent = false }
    tokenInput.value = ''
    updateTokenStatus(persistent)
  }, { signal: controller.signal })
  clearButton.addEventListener('click', () => {
    try { localStorage.removeItem('github_token') } catch { /* Storage may be unavailable. */ }
    token = ''
    tokenInput.value = ''
    updateTokenStatus()
  }, { signal: controller.signal })
  thoughtInput.addEventListener('input', () => {
    if (charCount) charCount.textContent = `${thoughtInput.value.length}/500`
  }, { signal: controller.signal })

  publishBtn.addEventListener('click', async() => {
    if (sending) return
    const content = thoughtInput.value.trim()
    if (!content || content.length > 500) {
      alert(content ? '请将内容控制在 500 字符以内' : '写点什么吧...')
      return
    }
    if (!token) { alert('请先设置 Token'); return }
    const requestToken = token
    sending = true
    publishBtn.disabled = true
    publishBtn.textContent = '正在发送...'
    const jsonUrl = 'https://api.github.com/repos/huamurui/huamurui.github.io/contents/src/data/sasayai.json'
    const headers = {
      Authorization: `Bearer ${requestToken}`,
      Accept: 'application/vnd.github+json'
    }
    try {
      const response = await fetch(jsonUrl, { headers, signal: controller.signal, cache: 'no-store' })
      if (!response.ok) throw new Error(`无法获取源文件 (HTTP ${response.status})，请检查 Token 或网络`)
      const file = await response.json()
      if (typeof file.sha !== 'string' || typeof file.content !== 'string' || file.encoding !== 'base64') {
        throw new Error('源文件响应不正确，已取消更新')
      }
      const data = decodeGitHubFile(file.content)
      const now = new Date()
      data.push({ id: `${now.getTime()}`, date: now.toISOString(), content })
      const result = await fetch(jsonUrl, {
        method: 'PUT',
        headers: { ...headers, 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({ message: 'Add whisper via web', content: encodeGitHubFile(data), sha: file.sha })
      })
      if (!result.ok) {
        if (result.status === 409) throw new Error('源文件已被其他更新修改，请重新点击发送')
        throw new Error(`更新失败 (HTTP ${result.status})`)
      }
      if (controller.signal.aborted) return
      alert('发送成功！GitHub 正在重新构建博客，请稍等几分钟后刷新页面。')
      thoughtInput.value = ''
      if (charCount) charCount.textContent = '0/500'
    } catch (error) {
      if (!controller.signal.aborted) alert(`出错啦: ${error instanceof Error ? error.message : String(error)}`)
    } finally {
      sending = false
      if (!controller.signal.aborted) {
        publishBtn.disabled = false
        publishBtn.textContent = '发送'
      }
    }
  }, { signal: controller.signal })
}

document.addEventListener('astro:page-load', initPublishPanel)
document.addEventListener('astro:before-swap', () => cleanupPublishPanel?.())
initPublishPanel()
</script>
